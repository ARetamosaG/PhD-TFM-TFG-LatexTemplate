	author = {Ye, Gao and Rui, Xue},
	date = {2013-11},
	keywords = {Algorithm design and analysis, Convergence, Elite selection operator, Genetic Algorithm, Genetic algorithms, Simulated annealing, Simulated annealing algorithm, Sociology, Statistics, {TSP}},
